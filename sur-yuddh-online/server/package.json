{
  "name": "suryuddh-server",
  "version": "1.0.0",
  "private": true,
  "description": "Sur Yuddh online backend — accounts, profiles, global leaderboard, room codes & realtime multiplayer with server-validated XP.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
